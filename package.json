{
  "name": "blevins-docket-mgr",
  "version": "1.0.0",
  "private": true,
  "description": "Legislative drafting and docket management for Blevins Holdings \u2014 Board of Governors. Akoma Ntoso document model, structured multi-document proposals, browser-grade PDF export.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @blevins/db generate",
    "db:migrate": "pnpm --filter @blevins/db migrate",
    "db:seed": "pnpm --filter @blevins/db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
