# Configuration for the drafting system (apps/api and apps/web).
#
# Copy to `.env` for local development. `.env` is gitignored; this file is not,
# so nothing with a real secret in it belongs here.

# --------------------------------------------------------------- database ----
DATABASE_URL=postgres://postgres@127.0.0.1:5432/blevins

# --------------------------------------------------------------- sessions ----
# Signs the session cookie. At least 32 characters; the API refuses to start
# with anything shorter. Generate with:  openssl rand -base64 32
#
# Changing it signs everybody out, which is also how you revoke every live
# session at once if one is ever thought to be compromised.
SESSION_SECRET=

# Public origin of the web app. Used to build the Entra redirect URI, so it has
# to match the app registration exactly, scheme and all.
APP_BASE_URL=http://127.0.0.1:3100

# ----------------------------------------------------- microsoft entra id ----
# From the app registration in the Azure portal. The tenant and client ids are
# identifiers, not secrets — they travel in the sign-in URL in plain sight.
AZURE_TENANT_ID=83ff87c7-db98-4775-939b-a58a5eb0f051
AZURE_CLIENT_ID=fdf8499c-7535-4112-aa06-149d5be2c722

# The client secret IS a secret, and must never be committed. In production set
# it out of band and let the platform inject it:
#
#   fly secrets set AZURE_CLIENT_SECRET='<value>' --app <app>
#
# Leave it empty here. With any of the four AZURE_*/APP_BASE_URL values missing,
# sign-in reports 503 rather than half-working.
AZURE_CLIENT_SECRET=

# Redirect URI to register on the app registration (Web platform):
#   <APP_BASE_URL>/api/auth/callback
# and as the front-channel logout URL:
#   <APP_BASE_URL>

# ------------------------------------------------------------ development ----
# Mints a session for any address already on the roster, with no credential at
# all. The API refuses to start if this is set while NODE_ENV=production.
# ALLOW_DEV_LOGIN=1

# Allow a session cookie over plain http, for a localhost without TLS.
# INSECURE_COOKIES=1

# API_LOG=1
