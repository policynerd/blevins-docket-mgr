{
  "name": "@blevins/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test --test-concurrency=1 test/*.test.ts",
    "dev": "node --experimental-strip-types --no-warnings --watch src/main.ts",
    "start": "node --experimental-strip-types --no-warnings src/main.ts"
  },
  "dependencies": {
    "@blevins/akn": "workspace:*",
    "@blevins/db": "workspace:*",
    "@blevins/pdf": "workspace:*",
    "fastify": "^5.2.0",
    "zod": "^3.24.1",
    "drizzle-orm": "^0.38.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "playwright-core": "^1.49.1",
    "pdf-lib": "^1.17.1"
  }
}
