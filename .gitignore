# Generated SQLite database (auto-seeded on first run)
/data/*.db
/data/*.db-shm
/data/*.db-wal

# Runtime database backups (auto-created on server startup)
/data/backups/

# Local environment files
.env
.env.*
!.env.example

# Dependencies (this project has none, but just in case)
/node_modules

# Logs & OS cruft
*.log
.DS_Store
