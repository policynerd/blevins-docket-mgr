# Generated SQLite databases (legacy app; auto-seeded on first run).
# `**/` on purpose: the legacy app falls back to its own ./data when DOCKET_DB
# is unset, so a working copy grows legacy/data/docket.db as well as
# /data/docket.db. These were once written `/data/*.db`, which git anchors to
# the repository root — legacy/data/ slipped past it and got committed.
**/data/*.db
**/data/*.db-shm
**/data/*.db-wal

# Runtime database backups (auto-created on server startup).
#
# BACKUP_DIR follows DOCKET_DB — it is `dirname(DB_PATH)/backups` — so pinning
# this to data/ only covered the default layout. Point DOCKET_DB anywhere else
# (an in-memory run puts it at the repo root) and a full copy of the database
# lands somewhere git was still willing to track. Match the directory by name
# wherever it appears.
**/backups/

# Local environment files
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
.next/
.turbo/
*.tsbuildinfo

# Logs & OS cruft
*.log
.DS_Store

# Next.js
.next/
apps/web/.env.local
